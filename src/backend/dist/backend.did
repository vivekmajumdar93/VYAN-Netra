type UserView = 
 record {
   createdAt: Timestamp;
   email: text;
   id: UserId;
   lastActivity: Timestamp;
   name: text;
   productId: nat;
   role: UserRole;
   status: UserStatus;
 };
type UserStatus = 
 variant {
   active;
   suspended;
 };
type UserRole = 
 variant {
   admin;
   manager;
   viewer;
 };
type UserId = nat;
type UserActivity = 
 record {
   description: text;
   eventType: ActivityEventType;
   id: Id;
   productId: nat;
   timestamp: Timestamp;
   userId: UserId;
 };
type UpdateView = 
 record {
   createdAt: Timestamp;
   deployedAt: opt Timestamp;
   id: UpdateId;
   productId: nat;
   releaseNotes: text;
   scheduledAt: opt Timestamp;
   size: nat;
   status: UpdateStatus;
   version: text;
 };
type UpdateStatus = 
 variant {
   deployed;
   failed;
   pending;
   scheduled;
 };
type UpdateId = nat;
type Timestamp = int;
type Time = int;
type SystemMetrics = 
 record {
   apiLatency: nat;
   connectionStatus: text;
   cpu: nat;
   disk: nat;
   id: Id;
   memory: nat;
   networkUptime: nat;
   productId: nat;
   timestamp: Timestamp;
 };
type ProductView = 
 record {
   code: text;
   description: text;
   id: ProductId;
   lastSync: Timestamp;
   name: text;
   registeredAt: Timestamp;
   status: ProductStatus;
 };
type ProductStatus = 
 variant {
   connected;
   disconnected;
 };
type ProductId = nat;
type NotificationView = 
 record {
   body: text;
   createdAt: Timestamp;
   id: Id;
   isRead: bool;
   notifType: NotificationType;
   productId: opt nat;
   severity: NotificationSeverity;
   snoozed: bool;
   snoozedUntil: opt Timestamp;
   title: text;
 };
type NotificationType = 
 variant {
   issue;
   systemAlert;
   update;
   user;
 };
type NotificationSeverity = 
 variant {
   critical;
   info;
   warning;
 };
type MetricSeverity = 
 variant {
   critical;
   info;
   warning;
 };
type IssueView = 
 record {
   assignedTo: opt nat;
   createdAt: Timestamp;
   description: text;
   id: IssueId;
   productId: nat;
   severity: IssueSeverity;
   status: IssueStatus;
   title: text;
   updatedAt: Timestamp;
 };
type IssueStatus = 
 variant {
   in_progress;
   open;
   resolved;
 };
type IssueSeverity = 
 variant {
   critical;
   high;
   low;
   medium;
 };
type IssueId = nat;
type IssueComment = 
 record {
   authorId: nat;
   content: text;
   id: Id;
   issueId: IssueId;
   timestamp: Timestamp;
 };
type Id = nat;
type EmailTemplateView = 
 record {
   body: text;
   id: Id;
   lastModified: Timestamp;
   name: text;
   productId: nat;
   subject: text;
 };
type EmailStatus = 
 variant {
   bounced;
   failed;
   sent;
 };
type EmailLog = 
 record {
   id: Id;
   productId: nat;
   recipient: text;
   status: EmailStatus;
   subject: text;
   timestamp: Timestamp;
 };
type EmailConfigView = 
 record {
   bounceEmail: text;
   createdAt: Timestamp;
   id: EmailConfigId;
   isActive: bool;
   productId: nat;
   senderEmail: text;
   senderName: text;
 };
type EmailConfigId = nat;
type AlertView = 
 record {
   id: Id;
   metricType: text;
   productId: nat;
   resolved: bool;
   resolvedAt: opt Timestamp;
   severity: MetricSeverity;
   threshold: nat;
   timestamp: Timestamp;
   value: nat;
 };
type ActivityEventType = 
 variant {
   action;
   login;
   permissionChange;
 };
service : {
  addEmailLog: (productId: nat, recipient: text, subject: text, status:
   EmailStatus) -> (EmailLog);
  addIssueComment: (issueId: nat, content: text, authorId: nat) ->
   (IssueComment);
  createAlert: (productId: nat, metricType: text, severity: MetricSeverity,
   value: nat, threshold: nat) -> (AlertView);
  createEmailConfig: (productId: nat, senderName: text, senderEmail: 
   text, bounceEmail: text) -> (EmailConfigView);
  createEmailTemplate: (productId: nat, name: text, subject: text, body:
   text) -> (EmailTemplateView);
  createIssue: (title: text, description: text, severity: IssueSeverity,
   productId: nat, assignedTo: opt nat) -> (IssueView);
  createNotification: (title: text, body: text, severity:
   NotificationSeverity, notifType: NotificationType, productId: opt nat) ->
   (NotificationView);
  createUpdate: (productId: nat, version: text, releaseNotes: text, size:
   nat) -> (UpdateView);
  createUser: (productId: nat, name: text, email: text, role: UserRole) ->
   (UserView);
  deleteEmailConfig: (id: nat) -> ();
  deleteEmailTemplate: (id: nat) -> ();
  disconnectProduct: (id: nat) -> ();
  dismissNotification: (id: nat) -> ();
  getLatestMetrics: (productId: nat) -> (opt SystemMetrics) query;
  getMetricsHistory: (productId: nat) -> (vec SystemMetrics) query;
  getProduct: (id: nat) -> (opt ProductView) query;
  listActiveAlerts: () -> (vec AlertView) query;
  listAlertHistory: (productId: nat) -> (vec AlertView) query;
  listAllUpdates: () -> (vec UpdateView) query;
  listEmailConfigs: (productId: nat) -> (vec EmailConfigView) query;
  listEmailLogs: (productId: nat) -> (vec EmailLog) query;
  listEmailTemplates: (productId: nat) -> (vec EmailTemplateView) query;
  listIssueComments: (issueId: nat) -> (vec IssueComment) query;
  listIssues: (productId: opt nat, status: opt IssueStatus, severity:
   opt IssueSeverity) -> (vec IssueView) query;
  listNotifications: (notifType: opt NotificationType, productId: opt nat,
   isRead: opt bool) -> (vec NotificationView) query;
  listProductUpdates: (productId: nat) -> (vec UpdateView) query;
  listProducts: () -> (vec ProductView) query;
  listUserActivities: (productId: nat) -> (vec UserActivity) query;
  listUsers: () -> (vec UserView) query;
  listUsersByProduct: (productId: nat) -> (vec UserView) query;
  logUserActivity: (userId: nat, productId: nat, eventType:
   ActivityEventType, description: text) -> ();
  markAllNotificationsRead: () -> ();
  markNotificationRead: (id: nat) -> ();
  markUpdateDeployed: (id: nat) -> ();
  reconnectProduct: (id: nat) -> ();
  registerProduct: (name: text, description: text, code: text) ->
   (ProductView);
  removeUser: (id: nat) -> ();
  resolveAlert: (id: nat) -> ();
  resolveIssue: (id: nat) -> ();
  restoreUser: (id: nat) -> ();
  scheduleUpdate: (id: nat, scheduledAt: Time) -> ();
  snoozeNotification: (id: nat, until: Time) -> ();
  submitMetrics: (productId: nat, cpu: nat, memory: nat, disk: nat,
   apiLatency: nat, networkUptime: nat, connectionStatus: text) ->
   (SystemMetrics);
  suspendUser: (id: nat) -> ();
  syncProduct: (id: nat) -> ();
  updateEmailConfig: (id: nat, senderName: text, senderEmail: text,
   bounceEmail: text, isActive: bool) -> ();
  updateEmailTemplate: (id: nat, subject: text, body: text) -> ();
  updateIssue: (id: nat, title: text, description: text, severity:
   IssueSeverity, status: IssueStatus, assignedTo: opt nat) -> ();
  updateProductMeta: (id: nat, name: text, description: text) -> ();
  updateUserRole: (id: nat, role: UserRole) -> ();
}
