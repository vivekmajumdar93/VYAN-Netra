rules_version = '2';

// All reads/writes go through Cloud Functions using the Admin SDK, which
// bypasses these rules entirely — mirrors the old ICP setup, where the only
// way to touch canister state was through an exposed actor method, never
// direct storage access. No client (authenticated or not) talks to
// Firestore directly.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
